{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
  { "src": "/assets/(.*).woff2", "dest": "/assets/$1.woff2" },
  { "src": "/assets/(.*).woff", "dest": "/assets/$1.woff" },
  { "src": "/(.*).js", "dest": "/$1.js" },
  { "src": "/(.*).css", "dest": "/$1.css" },
  { "src": "/(.*)", "dest": "/index.html" }
]

}
