{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/(.*).js", "dest": "/$1.js" },
    { "src": "/(.*).css", "dest": "/$1.css" },
    { "src": "/(.*).png", "dest": "/$1.png" },
    { "src": "/(.*).svg", "dest": "/$1.svg" },
    { "src": "/(.*).ico", "dest": "/$1.ico" },
    
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
