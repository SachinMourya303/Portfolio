{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
  { "src": "/assets/(.*).js", "dest": "/assets/$1.js" },
  { "src": "/assets/(.*).css", "dest": "/assets/$1.css" },
  { "src": "/assets/(.*).woff2", "dest": "/assets/$1.woff2" },
  { "src": "/assets/(.*).woff", "dest": "/assets/$1.woff" },
  { "src": "/img/(.*)", "dest": "/img/$1" },
  { "src": "/favicon.ico", "dest": "/favicon.ico" },
  { "src": "/(.*)", "dest": "/index.html" }
]

}
